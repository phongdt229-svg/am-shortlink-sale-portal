{
  "version": 1,
  "description": "Collection + index của Portal trong am_shortlink_report",
  "collections": [
    "portal_refresh_tokens",
    "portal_login_attempts",
    "portal_saved_reports",
    "portal_exports",
    "portal_audit_log"
  ],
  "indexes": [
    { "collection": "portal_refresh_tokens", "name": "ttl_expires_at", "keys": [["expires_at", 1]], "expire_after_seconds": 0 },
    { "collection": "portal_refresh_tokens", "name": "family_id", "keys": [["family_id", 1]] },
    { "collection": "portal_login_attempts", "name": "ttl_updated_at", "keys": [["updated_at", 1]], "expire_after_seconds": 86400 },
    { "collection": "portal_saved_reports", "name": "owner_updated", "keys": [["owner", 1], ["updated_at", -1]] },
    { "collection": "portal_saved_reports", "name": "share_token", "keys": [["share_token", 1]], "unique": true, "partial": { "share_token": { "$type": "string" } } },
    { "collection": "portal_exports", "name": "created_by_created_at", "keys": [["created_by", 1], ["created_at", -1]] },
    { "collection": "portal_exports", "name": "status_created_at", "keys": [["status", 1], ["created_at", 1]] },
    { "collection": "portal_exports", "name": "ttl_expires_at", "keys": [["expires_at", 1]], "expire_after_seconds": 0 },
    { "collection": "portal_audit_log", "name": "ts", "keys": [["ts", -1]] },
    { "collection": "portal_audit_log", "name": "actor_ts", "keys": [["actor", 1], ["ts", -1]] }
  ]
}
