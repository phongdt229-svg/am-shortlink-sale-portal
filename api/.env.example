# portal-api — biến môi trường (local). Copy thành .env (đã .gitignore).
# Secret thật ở Vault: isc-project/<PROJECT_FULLNAME>/<env>/am-shortlink-portal (đọc qua <TÊN>_FILE).
APP_ENV=local
HTTP_ADDR=:8080
LOG_LEVEL=debug

# MongoDB trong Docker (deploy/docker-compose.yml: mongo → cổng 27018). Xem dữ liệu: http://localhost:8081
MONGODB_URI=mongodb://localhost:27018/?directConnection=true
MONGODB_DB_CORE=am_shortlink
MONGODB_DB_REPORT=am_shortlink_report
MONGODB_READ_PREFERENCE=secondaryPreferred
MONGODB_MAX_TIME=10s

# Redis RIÊNG của Portal: cache báo cáo + rate limit đăng nhập. Để trống = tắt cache (fail-open).
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=am-shortlink-portal:
REPORT_CACHE_TTL=60s
REPORT_CACHE_TTL_PAST=15m

# >= 32 ký tự; local only
PORTAL_JWT_SIGNING_KEY=local-dev-jwt-signing-key-change-me-0123456789
PORTAL_ACCESS_TTL=15m
PORTAL_REFRESH_TTL=8h
PII_HASH_SALT=local-dev-pii-salt-0123456789

EXPORT_DIR=./var/exports
# Domain dựng short URL <base>/<prefix>/<code>
SHORT_URL_BASE=https://fpt.vn

# Log Kafka (để trống = chỉ stdout)
KAFKA_LOG_BROKERS=
KAFKA_LOG_TOPIC=

OTEL_ENABLED=false
OTEL_SERVICE_NAMESPACE=am-shortlink
OTEL_SERVICE_NAME=am-shortlink-portal-api
OTEL_ENDPOINT_TRACES=http://localhost:4318/v1/traces
OTEL_SAMPLER=always
