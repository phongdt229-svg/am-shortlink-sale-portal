# portal-web — biến môi trường. Copy thành .env.local (đã .gitignore).
# KHÔNG có thông tin MongoDB: portal-web chỉ gọi portal-api.
APP_ENV=local
PORTAL_API_URL=http://localhost:8080
# >= 32 ký tự — Vault: PORTAL_SESSION_SECRET
PORTAL_SESSION_SECRET=local-dev-session-secret-change-me-0123456789
# Origin công khai (kiểm CSRF). Để trống = lấy theo Host.
PORTAL_PUBLIC_ORIGIN=
SESSION_IDLE_HOURS=8
LOG_LEVEL=info

OTEL_ENABLED=false
OTEL_SERVICE_NAMESPACE=am-shortlink
OTEL_SERVICE_NAME=am-shortlink-portal-web
OTEL_ENDPOINT_TRACES=http://localhost:4318/v1/traces
OTEL_SAMPLER=always
